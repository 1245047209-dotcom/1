<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus 外设电量中心" Width="430" Height="570" MinWidth="410" MinHeight="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource ClientTintBrush}" AllowsTransparency="False"
        FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <SolidColorBrush x:Key="ClientTintBrush" Color="#00FFFFFF"/>
        <SolidColorBrush x:Key="BackdropFallbackBrush" Color="#EFF2F7"/>
        <SolidColorBrush x:Key="TextBrush" Color="#101B27"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#344557"/>
        <SolidColorBrush x:Key="WarningTextBrush" Color="#AF232B"/>
        <SolidColorBrush x:Key="CardFillBrush" Color="#D9FFFFFF"/>
        <SolidColorBrush x:Key="CardEdgeBrush" Color="#68FFFFFF"/>
        <SolidColorBrush x:Key="SoftCardFillBrush" Color="#66F0F4F7"/>
        <SolidColorBrush x:Key="SoftCardEdgeBrush" Color="#3B8492A3"/>
        <SolidColorBrush x:Key="RingTrackBrush" Color="#B9FFFFFF"/>
        <SolidColorBrush x:Key="HealthyRingBrush" Color="#2DC95B"/>
        <SolidColorBrush x:Key="MediumRingBrush" Color="#D69A13"/>
        <SolidColorBrush x:Key="LowRingBrush" Color="#F43D3B"/>
        <SolidColorBrush x:Key="RingIconBrush" Color="#132B43"/>
        <SolidColorBrush x:Key="ChargeGlyphBrush" Color="White"/>
        <SolidColorBrush x:Key="ArtworkFillBrush" Color="#67FFFFFF"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#2C55677E"/>
        <SolidColorBrush x:Key="RefreshButtonFillBrush" Color="#F20780F8"/>
        <SolidColorBrush x:Key="IconButtonFillBrush" Color="#B3F8FCFF"/>
        <SolidColorBrush x:Key="IconButtonTextBrush" Color="#067BDD"/>
        <SolidColorBrush x:Key="RowHoverBrush" Color="#38F8FCFF"/>
        <SolidColorBrush x:Key="FocusBrush" Color="#C80666CA"/>

        <Style x:Key="Subtle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style x:Key="PillFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border CornerRadius="15" BorderThickness="1"
                                BorderBrush="{DynamicResource FocusBrush}" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="15" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource IconButtonFillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource IconButtonTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        </Style>
        <Style x:Key="DeviceValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="DeviceRow" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14,24,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="3,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="设备" FontSize="31" FontWeight="Bold" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0">
                <Button x:Name="RefreshButton" Style="{StaticResource PillButton}" Padding="12,0" MinWidth="78"
                        Background="{DynamicResource RefreshButtonFillBrush}" Foreground="White"
                        ToolTip="刷新电量（F5）" AutomationProperties.Name="刷新电量">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding RefreshLabel, FallbackValue=刷新}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AddButton" Content="&#xE710;" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                        ToolTip="添加设备" AutomationProperties.Name="添加设备"/>
                <Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                        ToolTip="设置" AutomationProperties.Name="设置"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="1,3,0,0">
                <TextBlock Text="{Binding HeaderSummary, FallbackValue=正在读取设备…}" Margin="0,0,5,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLow}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding HeaderTime}" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <Border Padding="8,12,8,6">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=RingItems}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ItemsControl x:Name="RingItems" ItemsSource="{Binding Rings}" AutomationProperties.Name="设备电量">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,3,3,7" ToolTip="{Binding Label}">
                                    <Grid Width="53" Height="53" HorizontalAlignment="Center">
                                        <Ellipse Stroke="{DynamicResource RingTrackBrush}" StrokeThickness="5.5"/>
                                        <Path Data="{Binding Path}" Stroke="{Binding Color}" StrokeThickness="5.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{DynamicResource RingIconBrush}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Grid Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Charging}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Ellipse Fill="{DynamicResource HealthyRingBrush}" Stroke="White" StrokeThickness="1.5"/>
                                            <Path Fill="{DynamicResource ChargeGlyphBrush}" Data="M11.4,3.8 L6.7,10.4 H9.4 L8.5,16 L13.3,8.8 H10.7 Z"/>
                                        </Grid>
                                    </Grid>
                                    <TextBlock Text="{Binding LevelText}" Foreground="{Binding TextBrush}" FontSize="16"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,1"/>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Subtle}" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="我的设备" Style="{StaticResource Subtle}" Margin="12,17,0,8"/>
                <Border Style="{StaticResource Card}" CornerRadius="11">
                    <Grid>
                        <ListBox x:Name="DeviceList" ItemsSource="{Binding Devices}" AlternationCount="{Binding Devices.Count}"
                                 ItemContainerStyle="{StaticResource DeviceRow}"
                                 BorderThickness="0" Padding="2" Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                 AutomationProperties.Name="我的设备" KeyboardNavigation.DirectionalNavigation="Contained">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ItemsPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource DividerBrush}" Margin="8,0,6,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="0">
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid MinHeight="59">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="1.45*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.12*"/>
                                                <ColumnDefinition Width="12"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="37" Height="37" CornerRadius="9" Background="{DynamicResource ArtworkFillBrush}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Grid>
                                                    <Image Source="{Binding Artwork}" Margin="3" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="&#xE88E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource RingIconBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Artwork}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" FontSize="11"
                                                           Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <TextBlock Text="连接方式" Style="{StaticResource Subtle}"/>
                                                <TextBlock Text="{Binding Connection}" ToolTip="{Binding Connection}" Style="{StaticResource DeviceValue}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <TextBlock Text="供电状态" Style="{StaticResource Subtle}"/>
                                                <TextBlock Text="{Binding Power}" ToolTip="{Binding Power}" Style="{StaticResource DeviceValue}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="通过右上角的「+」添加外设" Margin="15,18" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=DeviceList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding FooterNote, FallbackValue='', TargetNullValue=''}" Margin="12,14,12,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="BackdropStatus" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource Subtle}"
                   Margin="12,9,12,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
