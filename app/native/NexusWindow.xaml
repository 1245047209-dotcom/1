<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:nx="clr-namespace:NexusUi;assembly=NexusNative"
        Title="Nexus 外设电量中心" Width="438" Height="608" MinWidth="412" MinHeight="450"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource ClientTintBrush}" AllowsTransparency="False"
        FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Light Liquid Glass palette. DarkTheme.xaml overrides every key it shares with this list. -->
        <SolidColorBrush x:Key="ClientTintBrush" Color="#10F3F6FB"/>
        <SolidColorBrush x:Key="BackdropFallbackBrush" Color="#F1F4F9"/>
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#526277"/>
        <SolidColorBrush x:Key="CaptionTextBrush" Color="#5A6A7E"/>
        <SolidColorBrush x:Key="ChevronBrush" Color="#8A99AD"/>
        <SolidColorBrush x:Key="WarningTextBrush" Color="#D92D20"/>
        <SolidColorBrush x:Key="HealthyTextBrush" Color="#1E9E46"/>
        <SolidColorBrush x:Key="CardFillBrush" Color="#E6FFFFFF"/>
        <SolidColorBrush x:Key="CardEdgeBrush" Color="#48FFFFFF"/>
        <SolidColorBrush x:Key="SolidCardFillBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SolidCardEdgeBrush" Color="#180F233C"/>
        <SolidColorBrush x:Key="SoftCardFillBrush" Color="#BDFAFBFD"/>
        <SolidColorBrush x:Key="SoftCardEdgeBrush" Color="#3094A3B8"/>
        <SolidColorBrush x:Key="CardShadowBrush" Color="#140F1F38"/>
        <LinearGradientBrush x:Key="CardHighlightBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D6FFFFFF" Offset="0"/>
            <GradientStop Color="#2AFFFFFF" Offset="0.32"/>
            <GradientStop Color="#00FFFFFF" Offset="0.58"/>
            <GradientStop Color="#66FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardInnerSheenBrush" StartPoint="0.1,0" EndPoint="0.65,1">
            <GradientStop Color="#56FFFFFF" Offset="0"/>
            <GradientStop Color="#0EFFFFFF" Offset="0.38"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="RingTrackBrush" Color="#160F233C"/>
        <SolidColorBrush x:Key="RingGhostBrush" Color="#0B0F233C"/>
        <SolidColorBrush x:Key="HealthyRingBrush" Color="#28C84E"/>
        <SolidColorBrush x:Key="MediumRingBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="LowRingBrush" Color="#FF3B30"/>
        <SolidColorBrush x:Key="RingIconBrush" Color="#1B2E46"/>
        <SolidColorBrush x:Key="ChargeGlyphBrush" Color="White"/>
        <SolidColorBrush x:Key="ChargeBadgeRimBrush" Color="#E6FFFFFF"/>
        <LinearGradientBrush x:Key="ChargeBadgeFillBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#48DF6B" Offset="0"/>
            <GradientStop Color="#20B944" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ArtworkFillBrush" Color="#ACF4F8FD"/>
        <LinearGradientBrush x:Key="ArtworkEdgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C4FFFFFF" Offset="0"/>
            <GradientStop Color="#140F233C" Offset="0.52"/>
            <GradientStop Color="#52FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GroupEdgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#CCFFFFFF" Offset="0"/>
            <GradientStop Color="#140F233C" Offset="0.45"/>
            <GradientStop Color="#58FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GroupInnerSheenBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#58FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.55"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DividerBrush" Color="#1847586E"/>
        <SolidColorBrush x:Key="RefreshButtonFillBrush" Color="#DF1677E8"/>
        <SolidColorBrush x:Key="RefreshButtonEdgeBrush" Color="#28004BB5"/>
        <LinearGradientBrush x:Key="PillGlossBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#54FFFFFF" Offset="0"/>
            <GradientStop Color="#0AFFFFFF" Offset="0.55"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="GlassDockFillBrush" Color="#B8FFFFFF"/>
        <SolidColorBrush x:Key="GlassDockEdgeBrush" Color="#1A0F233C"/>
        <SolidColorBrush x:Key="GlassDockHoverBrush" Color="#100F233C"/>
        <SolidColorBrush x:Key="IconButtonFillBrush" Color="#B8FFFFFF"/>
        <SolidColorBrush x:Key="IconButtonEdgeBrush" Color="#1A0F233C"/>
        <SolidColorBrush x:Key="IconButtonTextBrush" Color="#1F324B"/>
        <SolidColorBrush x:Key="CaptionHoverBrush" Color="#120F233C"/>
        <SolidColorBrush x:Key="RowHoverBrush" Color="#100B2545"/>
        <SolidColorBrush x:Key="PressOverlayBrush" Color="#1C0B1F33"/>
        <SolidColorBrush x:Key="FocusBrush" Color="#D9006CE0"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#006CE0"/>
        <SolidColorBrush x:Key="SheetFillBrush" Color="#D4EEF3FA"/>
        <SolidColorBrush x:Key="SolidSheetFillBrush" Color="#FFF2F5FA"/>
        <LinearGradientBrush x:Key="SheetEdgeBrush" StartPoint="0,0" EndPoint="1,0.35">
            <GradientStop Color="#F4FFFFFF" Offset="0"/>
            <GradientStop Color="#A8FFFFFF" Offset="0.5"/>
            <GradientStop Color="#66FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SheetTopGlowBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#72FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="SheetDimBrush" Color="#2C0B1220"/>
        <SolidColorBrush x:Key="GroupFillBrush" Color="#C2FFFFFF"/>
        <SolidColorBrush x:Key="SolidGroupFillBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SoftFillBrush" Color="#120F233C"/>
        <SolidColorBrush x:Key="SegmentTrackBrush" Color="#120F233C"/>
        <SolidColorBrush x:Key="SegmentTrackEdgeBrush" Color="#120F233C"/>
        <SolidColorBrush x:Key="SegmentThumbBrush" Color="#EBFFFFFF"/>
        <SolidColorBrush x:Key="SegmentThumbEdgeBrush" Color="#180F233C"/>
        <SolidColorBrush x:Key="SegmentTabHoverBrush" Color="#0C0F233C"/>
        <LinearGradientBrush x:Key="ShimmerBrush" StartPoint="0,0" EndPoint="1,0.15">
            <GradientStop Color="#00FFFFFF" Offset="0"/>
            <GradientStop Color="#3AFFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="GrabberBrush" Color="#380B1220"/>
        <SolidColorBrush x:Key="SwitchOffBrush" Color="#260F233C"/>
        <SolidColorBrush x:Key="SliderTrackBrush" Color="#180F233C"/>
        <SolidColorBrush x:Key="SliderFillBrush" Color="#EB1677E8"/>
        <SolidColorBrush x:Key="MenuFillBrush" Color="#DFF8FBFF"/>
        <LinearGradientBrush x:Key="MenuHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1C006CE0" Offset="0"/>
            <GradientStop Color="#0E006CE0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DarkDeviceRowHoverBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7282A2C8" Offset="0"/>
            <GradientStop Color="#3B748EAF" Offset="0.64"/>
            <GradientStop Color="#23748EAF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DarkDeviceRowMarkerBrush" Color="#DBA9C8EE"/>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <nx:SpringEase x:Key="GentleSpring" Damping="0.78"/>
        <nx:SpringEase x:Key="BouncySpring" Damping="0.62"/>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>

        <!-- Rounded Liquid Glass ToolTip -->
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Placement" Value="Bottom"/>
            <Setter Property="VerticalOffset" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{DynamicResource UiTooltipFont}"/>
            <Setter Property="FontWeight" Value="{DynamicResource UiTooltipWeight}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border x:Name="TipCard" Margin="8" Padding="10,5" CornerRadius="9"
                                Background="{DynamicResource MenuFillBrush}"
                                BorderBrush="{DynamicResource GroupEdgeBrush}" BorderThickness="1"
                                RenderTransformOrigin="0.5,0" Opacity="0">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.18" RenderingBias="Performance"/>
                            </Border.Effect>
                            <Grid>
                                <Border CornerRadius="8" Margin="-8,-4,-8,6" Background="{DynamicResource GroupInnerSheenBrush}" IsHitTestVisible="False"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TipCard" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="TipCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.28" EasingFunction="{StaticResource GentleSpring}"/>
                                        <DoubleAnimation Storyboard.TargetName="TipCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.28" EasingFunction="{StaticResource GentleSpring}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal iOS-style thin scrollbar without track or arrow buttons. -->
        <Style x:Key="ThinScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Pill" Width="3.5" CornerRadius="2" Margin="0,2"
                                HorizontalAlignment="Right" Background="{DynamicResource GrabberBrush}" Opacity="0.72"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Width" Value="5.5"/>
                                <Setter TargetName="Pill" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Pill" Property="Width" Value="5.5"/>
                                <Setter TargetName="Pill" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Margin" Value="0,4,2,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Keyboard focus rings fade in and settle with a small spring. -->
        <Style x:Key="PillFocusVisual" TargetType="Control">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border x:Name="Ring" CornerRadius="19" BorderThickness="2" Margin="-3" Opacity="0"
                                BorderBrush="{DynamicResource FocusBrush}" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.09" ScaleY="1.09"/>
                            </Border.RenderTransform>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.42" EasingFunction="{StaticResource BouncySpring}"/>
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.42" EasingFunction="{StaticResource BouncySpring}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowFocusVisual" TargetType="Control">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border x:Name="Ring" CornerRadius="12" BorderThickness="2" Margin="2,1" Opacity="0"
                                BorderBrush="{DynamicResource FocusBrush}" SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentFocusVisual" TargetType="Control">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border CornerRadius="15" BorderThickness="1.5" Margin="1" Opacity="0.72"
                                BorderBrush="{DynamicResource FocusBrush}" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkDeviceRowFocusVisual" TargetType="Control">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Grid>
                            <Border CornerRadius="12" BorderThickness="2" Margin="2,1" BorderBrush="{DynamicResource FocusBrush}" Opacity="0.85"/>
                            <Border Width="3" Height="22" CornerRadius="1.5" Margin="6,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{StaticResource DarkDeviceRowMarkerBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Type scale: 29 title, 16 ring values, 14.5 row titles, 12 secondary, 11.5 captions. -->
        <Style x:Key="Subtle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="{DynamicResource UiStrongWeight}"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>
        <Style x:Key="CardShadow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardShadowBrush}"/>
            <Setter Property="Margin" Value="8,10,8,-6"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <BlurEffect Radius="22" RenderingBias="Performance"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardHighlight" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardInnerSheenBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardHighlightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GroupFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GroupEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style x:Key="SheetGrabber" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="5"/>
            <Setter Property="CornerRadius" Value="2.5"/>
            <Setter Property="Background" Value="{DynamicResource GrabberBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PillGlossBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Opacity" Value="0.82"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width" To="46" Duration="0:0:0.26" EasingFunction="{StaticResource BouncySpring}"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width" To="38" Duration="0:0:0.24" EasingFunction="{StaticResource GentleSpring}"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.82" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Seamless Win11 caption bar buttons -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CaptionTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverBg" Background="{DynamicResource CaptionHoverBrush}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverBg" Background="#D93830" Opacity="0"/>
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="TextElement.Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverBg" Property="Background" Value="#B82C25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons: hover tint, deeper press tint, scale down on press and spring back on release. -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="{DynamicResource UiStrongWeight}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusVisual}"/>
            <Setter Property="nx:Motion.HoverScale" Value="1.02"/>
            <Setter Property="nx:Motion.PressScale" Value="0.94"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border x:Name="Face" CornerRadius="16" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <nx:SpecularOverlay CornerRadius="16" Intensity="0.5" RimOnly="True"/>
                            <Border x:Name="HoverTint" CornerRadius="16" Background="{DynamicResource PressOverlayBrush}" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="PressTint" CornerRadius="16" Background="{DynamicResource PressOverlayBrush}" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity" To="0.52" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressTint" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressTint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource IconButtonFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IconButtonEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource IconButtonTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="nx:Motion.HoverScale" Value="1.05"/>
            <Setter Property="nx:Motion.PressScale" Value="0.88"/>
        </Style>
        <Style x:Key="DockIconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource IconButtonTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusVisual}"/>
            <Setter Property="nx:Motion.HoverScale" Value="1.0"/>
            <Setter Property="nx:Motion.PressScale" Value="0.90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverBg" CornerRadius="14" Margin="2"
                                    Background="{DynamicResource GlassDockHoverBrush}" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="PressBg" CornerRadius="14" Margin="2"
                                    Background="{DynamicResource PressOverlayBrush}" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="nx:Motion.HoverScale" Value="1.0"/>
            <Setter Property="nx:Motion.PressScale" Value="0.95"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <Border x:Name="HoverTint" CornerRadius="15" Background="{DynamicResource RowHoverBrush}" Opacity="0"/>
                            <Border x:Name="PressTint" CornerRadius="15" Background="{DynamicResource PressOverlayBrush}" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressTint" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{DynamicResource IconButtonFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IconButtonEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
        <Style x:Key="GroupButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RowFocusVisual}"/>
            <Setter Property="nx:Motion.PressScale" Value="0.985"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <Border x:Name="HoverTint" CornerRadius="10" Margin="3,2" Background="{DynamicResource RowHoverBrush}" Opacity="0"/>
                            <Border x:Name="PressTint" CornerRadius="10" Margin="3,2" Background="{DynamicResource PressOverlayBrush}" Opacity="0"/>
                            <ContentPresenter Margin="14,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressTint" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressTint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Translucent crystal gem icon tile for Settings rows -->
        <Style x:Key="SettingSwatch" TargetType="ContentControl">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border CornerRadius="7.5" Background="{TemplateBinding Background}" Opacity="0.92">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Direction="270" Opacity="0.18" RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="7.5" Margin="0.8,0.8,0.8,11" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                                        <GradientStop Color="#66FFFFFF" Offset="0"/>
                                        <GradientStop Color="#0CFFFFFF" Offset="0.65"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="7.5" BorderThickness="1" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#72FFFFFF" Offset="0"/>
                                        <GradientStop Color="#12FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#30FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="{DynamicResource UiStrongWeight}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Light rows: soft rounded highlight on hover, press darken + subtle spring scale. -->
        <Style x:Key="DeviceRow" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RowFocusVisual}"/>
            <Setter Property="nx:Motion.PressScale" Value="0.985"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="RowSurface" Background="{TemplateBinding Background}">
                            <Border x:Name="HoverLayer" CornerRadius="12" Margin="4,2" Background="{DynamicResource RowHoverBrush}" Opacity="0"/>
                            <Border x:Name="PressLayer" CornerRadius="12" Margin="4,2" Background="{DynamicResource PressOverlayBrush}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.36"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark rows keep the v73.7 sweeping side light and pair it with a spring marker & press scale. -->
        <Style x:Key="DarkDeviceRow" TargetType="ListBoxItem" BasedOn="{StaticResource DeviceRow}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource DarkDeviceRowFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="RowSurface" Background="{TemplateBinding Background}">
                            <Border x:Name="HoverSurface" Background="{StaticResource DarkDeviceRowHoverBrush}"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.18,0" SpreadMethod="Pad">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-0.18"/>
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF000000" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="PressLayer" Background="{DynamicResource PressOverlayBrush}" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="HoverMarker" Width="3" Height="22" CornerRadius="1.5"
                                    Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{StaticResource DarkDeviceRowMarkerBrush}"
                                    Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.2"/>
                                </Border.RenderTransform>
                            </Border>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="2,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverSurface" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="HoverMarker" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="RevealDarkDeviceRowHover" HandoffBehavior="SnapshotAndReplace">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                             From="-0.18" To="1" Duration="0:0:0.32" EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverMarker"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="0.2" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource BouncySpring}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="RevealDarkDeviceRowHover"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.36"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context & picker menu: rounded Liquid Glass card that fades and grows from the pointer. -->
        <Style x:Key="NexusMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="MenuFace" Margin="12" Padding="5" MinWidth="158" CornerRadius="14"
                                Background="{DynamicResource MenuFillBrush}" BorderBrush="{DynamicResource GroupEdgeBrush}"
                                BorderThickness="1" RenderTransformOrigin="0,0" Opacity="0">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.93" ScaleY="0.93"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.24" RenderingBias="Performance"/>
                            </Border.Effect>
                            <Grid>
                                <Border CornerRadius="12" Margin="-3,-3,-3,18" Background="{DynamicResource GroupInnerSheenBrush}" IsHitTestVisible="False"/>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MenuFace" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="MenuFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.34" EasingFunction="{StaticResource GentleSpring}"/>
                                        <DoubleAnimation Storyboard.TargetName="MenuFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.34" EasingFunction="{StaticResource GentleSpring}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Highlight" CornerRadius="9" Padding="12,8" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                        <Setter TargetName="Highlight" Property="BorderBrush" Value="{DynamicResource PillGlossBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter Property="BorderThickness" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Gentle diagonal shimmer sweep displayed over cards while hardware readings are in flight -->
        <Style x:Key="ShimmerSweep" TargetType="Control">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border x:Name="Host" CornerRadius="16" ClipToBounds="True" Opacity="0">
                            <Border x:Name="Band" Width="180" HorizontalAlignment="Left" Background="{DynamicResource ShimmerBrush}">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-200"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Refreshing}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="RunShimmer">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Host" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Band"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="-190" To="430" Duration="0:0:1.25" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Host" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Seamless integrated titlebar sharing the same Acrylic canvas -->
        <Grid x:Name="TitleBar" Panel.ZIndex="10" Background="{x:Null}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,2,0,0" IsHitTestVisible="False">
                <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" Width="15" Height="15"
                       Opacity="0.86" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Nexus 外设电量中心" FontSize="12" Foreground="{DynamicResource CaptionTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="CaptionMinButton" Content="&#xE921;" Style="{StaticResource CaptionButton}" ToolTip="最小化" AutomationProperties.Name="最小化"/>
                <Button x:Name="CaptionMaxButton" Style="{StaticResource CaptionButton}" ToolTip="最大化" AutomationProperties.Name="最大化">
                    <Button.Content>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>
                <Button x:Name="CaptionCloseButton" Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}" ToolTip="关闭" AutomationProperties.Name="关闭"/>
            </StackPanel>
        </Grid>

        <!-- ==================== MAIN OVERVIEW LAYER ==================== -->
        <Grid x:Name="MainLayer" Grid.Row="1" Margin="16,8,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderArea" Margin="3,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="设备" FontSize="29" FontWeight="{DynamicResource UiHeadingWeight}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Style="{StaticResource PillButton}" Padding="14,0,15,0" MinWidth="80"
                            Background="{DynamicResource RefreshButtonFillBrush}" Foreground="#F4F8FF"
                            BorderBrush="{DynamicResource RefreshButtonEdgeBrush}" BorderThickness="1"
                            ToolTip="刷新电量（F5）" AutomationProperties.Name="刷新电量">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontWeight="SemiBold" FontSize="12.5"
                                       Width="14" Height="14" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                       TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,7,0"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Refreshing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:0.88" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             To="360" Duration="0:0:0.38" FillBehavior="Stop" EasingFunction="{StaticResource EaseOut}"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding RefreshLabel, FallbackValue=刷新}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="ActionDock" Height="32" CornerRadius="16" Margin="8,0,0,0"
                            Background="{DynamicResource GlassDockFillBrush}"
                            BorderBrush="{DynamicResource GlassDockEdgeBrush}" BorderThickness="1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="AddButton" Content="&#xE710;" Style="{StaticResource DockIconButton}"
                                        ToolTip="添加设备" AutomationProperties.Name="添加设备"/>
                                <Border Width="1" Height="14" Background="{DynamicResource DividerBrush}"
                                        VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource DockIconButton}"
                                        ToolTip="设置（Ctrl+,）" AutomationProperties.Name="设置"/>
                            </StackPanel>
                            <nx:SpecularOverlay CornerRadius="16" Intensity="0.45" RimOnly="True"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="1,5,0,0">
                    <TextBlock Text="{Binding HeaderSummary, FallbackValue=正在读取设备…}" Margin="0,0,4,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                                <Setter Property="FontSize" Value="12.5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLow}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                        <Setter Property="FontWeight" Value="{DynamicResource UiStrongWeight}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding HeaderTime}" Style="{StaticResource Subtle}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" nx:Motion.SmoothScroll="True">
                <StackPanel Margin="0,0,0,8">
                    <Grid x:Name="RingCard">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=RingItems}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border Style="{StaticResource CardShadow}" CornerRadius="18"/>
                        <Border Style="{StaticResource Card}" Padding="8,16,8,8">
                            <ItemsControl x:Name="RingItems" ItemsSource="{Binding Rings}" AutomationProperties.Name="设备电量">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,0,2,6">
                                            <!-- Ghost placeholder slot when fewer than 4 rings are present -->
                                            <Ellipse Width="56" Height="56" VerticalAlignment="Top" HorizontalAlignment="Center"
                                                     Stroke="{DynamicResource RingGhostBrush}" StrokeThickness="5.8" IsHitTestVisible="False"
                                                     Visibility="{Binding GhostVisibility}"/>
                                            <Grid Background="Transparent" Cursor="Hand" ToolTip="{Binding Label}"
                                                  Visibility="{Binding ContentVisibility}"
                                                  nx:Motion.HoverScale="1.045" nx:Motion.PressScale="0.93">
                                                <StackPanel>
                                                    <Grid Width="56" Height="56" HorizontalAlignment="Center">
                                                        <nx:BatteryRing Value="{Binding LevelValue}" Charging="{Binding Charging}" Stroke="{Binding Color}"
                                                                        Track="{DynamicResource RingTrackBrush}" Thickness="5.6"/>
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontWeight="Normal" FontSize="17"
                                                                   Foreground="{DynamicResource RingIconBrush}" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <Grid Width="20" Height="20" Margin="0,-2,-2,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Grid.RenderTransform>
                                                                <ScaleTransform/>
                                                            </Grid.RenderTransform>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Charging}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <DataTrigger.EnterActions>
                                                                                <BeginStoryboard Name="ChargeBadgePulse">
                                                                                    <Storyboard>
                                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                                         From="0.3" To="1" Duration="0:0:0.52" EasingFunction="{StaticResource BouncySpring}"/>
                                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                                         From="0.3" To="1" Duration="0:0:0.52" EasingFunction="{StaticResource BouncySpring}"/>
                                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                         From="1" To="0.76" BeginTime="0:0:0.52" Duration="0:0:1.5"
                                                                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </DataTrigger.EnterActions>
                                                                            <DataTrigger.ExitActions>
                                                                                <RemoveStoryboard BeginStoryboardName="ChargeBadgePulse"/>
                                                                            </DataTrigger.ExitActions>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Ellipse Fill="{DynamicResource ChargeBadgeFillBrush}" Stroke="{DynamicResource ChargeBadgeRimBrush}" StrokeThickness="1.3"/>
                                                            <Ellipse Margin="3,1.5,3,10" Fill="#48FFFFFF" IsHitTestVisible="False"/>
                                                            <Path Fill="{DynamicResource ChargeGlyphBrush}" Data="M11.4,3.8 L6.7,10.4 H9.4 L8.5,16 L13.3,8.8 H10.7 Z"/>
                                                        </Grid>
                                                    </Grid>
                                                    <nx:CountingText Value="{Binding Level}" Placeholder="--" Foreground="{Binding TextBrush}" FontSize="15.5"
                                                                     FontWeight="{DynamicResource UiStrongWeight}" HorizontalAlignment="Center" Margin="0,9,0,1"/>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Subtle}" FontSize="11.5" TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Control Style="{StaticResource ShimmerSweep}"/>
                        <Border Style="{StaticResource CardHighlight}" CornerRadius="18"/>
                        <nx:SpecularOverlay CornerRadius="18" Intensity="1.0"/>
                    </Grid>

                    <TextBlock x:Name="ListLabel" Text="我的设备" Style="{StaticResource SectionLabel}" Margin="14,20,0,8"/>
                    <Grid x:Name="ListCard">
                        <Border Style="{StaticResource CardShadow}" CornerRadius="16"/>
                        <Border Style="{StaticResource Card}" CornerRadius="16">
                            <Grid x:Name="DeviceListSurface">
                                <ListBox x:Name="DeviceList" ItemsSource="{Binding Devices}" AlternationCount="{Binding Devices.Count}"
                                         ItemContainerStyle="{StaticResource DeviceRow}"
                                         BorderThickness="0" Padding="2" Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                         AutomationProperties.Name="我的设备" KeyboardNavigation.DirectionalNavigation="Contained">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ItemsPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="66" Margin="12,0,10,0">
                                                <!-- iOS inset hairline separator aligned with the text column -->
                                                <Border BorderBrush="{DynamicResource DividerBrush}" Margin="54,0,0,0" VerticalAlignment="Top" Height="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Disconnected}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.56" Duration="0:0:0.32" EasingFunction="{StaticResource EaseOut}"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="16"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="43" Height="43" CornerRadius="11"
                                                            Background="{DynamicResource ArtworkFillBrush}"
                                                            BorderBrush="{DynamicResource ArtworkEdgeBrush}" BorderThickness="1"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform/>
                                                        </Border.RenderTransform>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                                     To="1.06" Duration="0:0:0.46" EasingFunction="{StaticResource BouncySpring}"/>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                                     To="1.06" Duration="0:0:0.46" EasingFunction="{StaticResource BouncySpring}"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                                     To="1" Duration="0:0:0.4" EasingFunction="{StaticResource GentleSpring}"/>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                                     To="1" Duration="0:0:0.4" EasingFunction="{StaticResource GentleSpring}"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Image Source="{Binding Artwork}" Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontWeight="Normal" FontSize="17"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource RingIconBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Artwork}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="14.5"
                                                                   FontWeight="{DynamicResource UiStrongWeight}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" FontSize="12" Margin="0,3,0,0"
                                                                   Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0" MaxWidth="128">
                                                        <TextBlock Text="{Binding Connection}" ToolTip="连接方式" Style="{StaticResource DeviceValue}"/>
                                                        <TextBlock Text="{Binding Power}" ToolTip="供电状态" FontSize="11.5" Foreground="{Binding PowerBrush}"
                                                                   TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="&#xE784;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{DynamicResource ChevronBrush}" VerticalAlignment="Center" Margin="0,0,5,0"
                                                               Opacity="0" ToolTip="上下拖动可调整顺序">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanReorder}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding CanReorder}" Value="True"/>
                                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <MultiDataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.52" Duration="0:0:0.16"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </MultiDataTrigger.EnterActions>
                                                                        <MultiDataTrigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </MultiDataTrigger.ExitActions>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="4" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontWeight="Normal" FontSize="10"
                                                               Foreground="{DynamicResource ChevronBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock.RenderTransform>
                                                            <TranslateTransform/>
                                                        </TextBlock.RenderTransform>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                                     To="3" Duration="0:0:0.42" EasingFunction="{StaticResource BouncySpring}"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                                     To="0" Duration="0:0:0.38" EasingFunction="{StaticResource GentleSpring}"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <!-- Illustrated Empty State Card when 0 devices are configured -->
                                <StackPanel Margin="20,28,20,26" HorizontalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=DeviceList}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource ArtworkFillBrush}"
                                                BorderBrush="{DynamicResource ArtworkEdgeBrush}" BorderThickness="1" Margin="0,6,-8,0" Opacity="0.82">
                                            <TextBlock Text="&#xE962;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource MutedTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource IconButtonFillBrush}"
                                                BorderBrush="{DynamicResource IconButtonEdgeBrush}" BorderThickness="1" Panel.ZIndex="2">
                                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource ArtworkFillBrush}"
                                                BorderBrush="{DynamicResource ArtworkEdgeBrush}" BorderThickness="1" Margin="-8,6,0,0" Opacity="0.82">
                                            <TextBlock Text="&#xE7F6;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource MutedTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="尚未添加外设" FontSize="15" FontWeight="{DynamicResource UiStrongWeight}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="支持 2.4G 无线接收器、USB 外设与蓝牙设备" Style="{StaticResource Subtle}" FontSize="12"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,16"/>
                                    <Button x:Name="EmptyAddButton" Style="{StaticResource PillButton}" HorizontalAlignment="Center"
                                            Background="{DynamicResource RefreshButtonFillBrush}" Foreground="#F4F8FF"
                                            BorderBrush="{DynamicResource RefreshButtonEdgeBrush}" BorderThickness="1" Padding="18,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="搜索并添加设备" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Control Style="{StaticResource ShimmerSweep}"/>
                        <Border Style="{StaticResource CardHighlight}" CornerRadius="16"/>
                        <nx:SpecularOverlay CornerRadius="16" Intensity="0.95"/>
                    </Grid>

                    <TextBlock x:Name="FooterNote" Text="{Binding FooterNote, FallbackValue='', TargetNullValue=''}" Margin="14,14,12,0"
                               Style="{StaticResource OptionalText}" FontSize="11.5"/>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="BackdropStatus" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource Subtle}"
                       Margin="12,9,12,0" TextWrapping="Wrap"/>
        </Grid>

        <!-- ==================== DEVICE DETAILS SHEET ==================== -->
        <Grid x:Name="SheetLayer" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" ClipToBounds="True">
            <Border x:Name="SheetDim" Background="{DynamicResource SheetDimBrush}" Opacity="0"/>
            <Border x:Name="Sheet" VerticalAlignment="Bottom" Margin="0,56,0,0" CornerRadius="20,20,0,0"
                    Background="{DynamicResource SheetFillBrush}" BorderBrush="{DynamicResource SheetEdgeBrush}" BorderThickness="0,1,0,0"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.Name="设备信息">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Height="64" VerticalAlignment="Top" CornerRadius="20,20,0,0"
                            Background="{DynamicResource SheetTopGlowBrush}" IsHitTestVisible="False"/>
                    <Grid x:Name="SheetHandle" Height="54" Background="Transparent" Cursor="SizeNS" ToolTip="向下拖动以关闭">
                        <Border Style="{StaticResource SheetGrabber}"/>
                        <TextBlock Text="设备信息" FontSize="14.5" FontWeight="{DynamicResource UiStrongWeight}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <Button x:Name="SheetDone" Content="完成" Style="{StaticResource TextButton}" Cursor="Hand"
                                FontWeight="{DynamicResource UiStrongWeight}" ToolTip="{x:Null}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,8,0" AutomationProperties.Name="完成"/>
                    </Grid>
                    <ScrollViewer x:Name="SheetScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False" nx:Motion.SmoothScroll="True">
                        <StackPanel x:Name="SheetContent" Margin="16,2,16,18">
                            <StackPanel HorizontalAlignment="Stretch">
                                <!-- Multi-device switcher arrows + product card -->
                                <Grid HorizontalAlignment="Stretch">
                                    <Button x:Name="SheetPrevButton" Content="&#xE76B;" Style="{StaticResource IconButton}"
                                            Width="30" Height="30" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                                            ToolTip="上一台设备（←）" AutomationProperties.Name="上一台设备"
                                            Visibility="{Binding HasMultipleDevices, Converter={StaticResource Visible}}"/>
                                    <Border Width="132" Height="94" CornerRadius="22" Background="{DynamicResource GroupFillBrush}"
                                            BorderBrush="{DynamicResource GroupEdgeBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                        <Grid>
                                            <Border CornerRadius="21" Margin="1,1,1,38" Background="{DynamicResource GroupInnerSheenBrush}" IsHitTestVisible="False"/>
                                            <Image Source="{Binding Artwork}" Margin="10" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource RingIconBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Artwork}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <nx:SpecularOverlay CornerRadius="22" Intensity="1.1"/>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="SheetNextButton" Content="&#xE76C;" Style="{StaticResource IconButton}"
                                            Width="30" Height="30" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                            ToolTip="下一台设备（→）" AutomationProperties.Name="下一台设备"
                                            Visibility="{Binding HasMultipleDevices, Converter={StaticResource Visible}}"/>
                                </Grid>

                                <!-- iOS Page Indicator Dots -->
                                <ItemsControl x:Name="SheetDots" ItemsSource="{Binding PageDots}" HorizontalAlignment="Center" Margin="0,10,0,0"
                                              Focusable="False" Visibility="{Binding HasMultipleDevices, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding Id}" Cursor="Hand" Padding="3,4" Background="Transparent" BorderThickness="0" Focusable="False">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Background="Transparent" Margin="3,2">
                                                            <Border Width="{Binding DotWidth}" Height="6" CornerRadius="3" Background="{Binding DotBrush}"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="{DynamicResource UiHeadingWeight}"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <nx:CountingText Value="{Binding LevelValue}" Placeholder="{Binding LevelText}" FontSize="42"
                                                 FontWeight="{DynamicResource UiStrongWeight}" Foreground="{Binding LevelBrush}"
                                                 HorizontalAlignment="Center" Margin="0,1,0,1"/>
                                <TextBlock Text="{Binding Caption, TargetNullValue=''}" FontSize="13" Foreground="{Binding StatusBrush}"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Timestamp, TargetNullValue=''}" Style="{StaticResource OptionalText}"
                                           TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Battery Trend Sparkline Card -->
                            <Border Style="{StaticResource Group}" Padding="16,12,16,10" Margin="0,16,0,0"
                                    Visibility="{Binding HasHistory, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="电量趋势" FontSize="13" FontWeight="{DynamicResource UiStrongWeight}"/>
                                        <TextBlock Text="{Binding TrendSummary}" Style="{StaticResource Subtle}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <nx:SparklineChart x:Name="DetailSparkline" Points="{Binding HistoryPoints}"
                                                       Stroke="{Binding SparklineBrush}" GuideBrush="{DynamicResource DividerBrush}"
                                                       Height="68" Margin="0,8,0,4"/>
                                    <Grid>
                                        <TextBlock Text="{Binding HistoryStartLabel}" Style="{StaticResource Subtle}" FontSize="11"/>
                                        <TextBlock Text="现在" Style="{StaticResource Subtle}" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Group}" Margin="0,16,0,0"
                                    Visibility="{Binding HasComponents, Converter={StaticResource Visible}}">
                                <ItemsControl ItemsSource="{Binding Components}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Divider}" Margin="16,0,0,0">
                                                <Grid MinHeight="44" Margin="0,0,16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontSize="13.5" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Subtle}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                   Foreground="{DynamicResource HealthyRingBrush}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                   Visibility="{Binding Charging, Converter={StaticResource Visible}}" ToolTip="充电中"/>
                                                        <TextBlock Text="{Binding Level}" FontSize="13.5" FontWeight="{DynamicResource UiStrongWeight}"
                                                                   Typography.NumeralAlignment="Tabular"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Border Style="{StaticResource Group}" Margin="0,12,0,0"
                                    Visibility="{Binding HasRows, Converter={StaticResource Visible}}">
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Divider}" Margin="16,0,0,0">
                                                <Grid MinHeight="44" Margin="0,0,16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontSize="13.5" Foreground="{DynamicResource MutedTextBrush}"
                                                               VerticalAlignment="Center" Margin="0,11,14,11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13.5" TextAlignment="Right"
                                                               FontWeight="{DynamicResource UiStrongWeight}" TextWrapping="Wrap"
                                                               VerticalAlignment="Center" Margin="0,11,0,11"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <StackPanel Margin="14,10,14,0">
                                <TextBlock Text="{Binding Footer, TargetNullValue=''}" Style="{StaticResource OptionalText}" FontSize="11.5"/>
                                <TextBlock Text="{Binding Source, TargetNullValue=''}" Style="{StaticResource OptionalText}" FontSize="11.5" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Border Style="{StaticResource Group}" Margin="0,14,0,0">
                                <StackPanel>
                                    <Button x:Name="SheetRefresh" IsEnabled="{Binding IsEnabled, ElementName=RefreshButton}"
                                            HorizontalContentAlignment="Left" Foreground="{DynamicResource AccentTextBrush}" AutomationProperties.Name="立即读取">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GroupButton}">
                                                <Setter Property="Content" Value="立即读取"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Content" Value="正在读取…"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="16,0,0,0"
                                            Visibility="{Binding CanRemove, Converter={StaticResource Visible}}"/>
                                    <Button x:Name="SheetRemove" Style="{StaticResource GroupButton}" HorizontalContentAlignment="Left"
                                            Content="{Binding RemoveLabel, FallbackValue=移除设备}"
                                            Foreground="{DynamicResource WarningTextBrush}" AutomationProperties.Name="移除设备"
                                            Visibility="{Binding CanRemove, Converter={StaticResource Visible}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== SETTINGS SHEET & SUBPAGES ==================== -->
        <Grid x:Name="SettingsLayer" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" ClipToBounds="True">
            <Border x:Name="SettingsDim" Background="{DynamicResource SheetDimBrush}" Opacity="0"/>
            <Border x:Name="SettingsSheet" VerticalAlignment="Stretch" Margin="0,44,0,0" CornerRadius="20,20,0,0"
                    Background="{DynamicResource SheetFillBrush}" BorderBrush="{DynamicResource SheetEdgeBrush}" BorderThickness="0,1,0,0"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.Name="设置">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="3" Height="64" VerticalAlignment="Top" CornerRadius="20,20,0,0"
                            Background="{DynamicResource SheetTopGlowBrush}" IsHitTestVisible="False"/>

                    <!-- Navigation Header -->
                    <Grid x:Name="SettingsHandle" Height="54" Background="Transparent" Cursor="SizeNS" ToolTip="向下拖动以关闭">
                        <Border Style="{StaticResource SheetGrabber}"/>
                        <Button x:Name="SettingsCancelButton" Content="取消" Style="{StaticResource TextButton}" Cursor="Hand"
                                ToolTip="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,8,0,0"/>
                        <Button x:Name="SettingsBackButton" Style="{StaticResource TextButton}" Cursor="Hand" Visibility="Collapsed"
                                ToolTip="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="设置" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="SettingsTitle" Text="设置" FontSize="15" FontWeight="{DynamicResource UiStrongWeight}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <Button x:Name="SettingsDoneButton" Content="完成" Style="{StaticResource TextButton}" Cursor="Hand"
                                FontWeight="{DynamicResource UiStrongWeight}" ToolTip="{x:Null}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,8,0"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding SaveError, FallbackValue=''}" Foreground="{DynamicResource WarningTextBrush}"
                               FontSize="12" Margin="18,0,18,8" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Clipped Page Host for iOS Horizontal Push / Pop Transitions -->
                    <Grid x:Name="SettingsViewport" Grid.Row="2" ClipToBounds="True">
                        <!-- Page 1: Root Settings -->
                        <ScrollViewer x:Name="SettingsHomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" nx:Motion.SmoothScroll="True">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform/>
                            </ScrollViewer.RenderTransform>
                            <StackPanel Margin="16,2,16,22">
                                <!-- 外观 -->
                                <TextBlock Text="外观" Style="{StaticResource SectionLabel}" Margin="12,4,0,7"/>
                                <Border Style="{StaticResource Group}">
                                    <StackPanel>
                                        <UniformGrid Columns="2" Margin="10,12,10,10">
                                            <!-- Light Mode Preview Card -->
                                            <Button x:Name="LightModeCard" Cursor="Hand" Margin="4,0" Foreground="{DynamicResource TextBrush}"
                                                    nx:Motion.PressScale="0.95" FocusVisualStyle="{StaticResource RowFocusVisual}" AutomationProperties.Name="浅色外观">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <StackPanel Background="Transparent">
                                                            <Border Height="68" CornerRadius="11" Background="#EEF2F7" Padding="8"
                                                                    BorderThickness="2" BorderBrush="{Binding LightCardBorder}">
                                                                <StackPanel>
                                                                    <Border Height="16" CornerRadius="5" Background="White" Margin="0,0,0,6">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                                            <Ellipse Width="7" Height="7" Fill="#28C84E" Margin="0,0,4,0"/>
                                                                            <Border Width="28" Height="4" CornerRadius="2" Background="#CBD5E1"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Height="26" CornerRadius="6" Background="White" Padding="6,4">
                                                                        <StackPanel>
                                                                            <Border Width="48" Height="4" CornerRadius="2" Background="#334155" HorizontalAlignment="Left"/>
                                                                            <Border Width="32" Height="3.5" CornerRadius="1.5" Background="#94A3B8" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,2">
                                                                <Grid Width="17" Height="17" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                    <Ellipse Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Opacity="0.6"
                                                                             Visibility="{Binding LightUncheckedVisibility}"/>
                                                                    <Grid Visibility="{Binding LightCheckedVisibility}">
                                                                        <Ellipse Fill="{DynamicResource AccentTextBrush}"/>
                                                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9.5" FontWeight="Bold"
                                                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Grid>
                                                                <TextBlock Text="浅色" FontSize="12.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Dark Mode Preview Card -->
                                            <Button x:Name="DarkModeCard" Cursor="Hand" Margin="4,0" Foreground="{DynamicResource TextBrush}"
                                                    nx:Motion.PressScale="0.95" FocusVisualStyle="{StaticResource RowFocusVisual}" AutomationProperties.Name="深色外观">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <StackPanel Background="Transparent">
                                                            <Border Height="68" CornerRadius="11" Background="#131824" Padding="8"
                                                                    BorderThickness="2" BorderBrush="{Binding DarkCardBorder}">
                                                                <StackPanel>
                                                                    <Border Height="16" CornerRadius="5" Background="#222A3B" Margin="0,0,0,6">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                                            <Ellipse Width="7" Height="7" Fill="#32D74B" Margin="0,0,4,0"/>
                                                                            <Border Width="28" Height="4" CornerRadius="2" Background="#475569"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Height="26" CornerRadius="6" Background="#222A3B" Padding="6,4">
                                                                        <StackPanel>
                                                                            <Border Width="48" Height="4" CornerRadius="2" Background="#E2E8F0" HorizontalAlignment="Left"/>
                                                                            <Border Width="32" Height="3.5" CornerRadius="1.5" Background="#64748B" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,2">
                                                                <Grid Width="17" Height="17" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                    <Ellipse Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Opacity="0.6"
                                                                             Visibility="{Binding DarkUncheckedVisibility}"/>
                                                                    <Grid Visibility="{Binding DarkCheckedVisibility}">
                                                                        <Ellipse Fill="{DynamicResource AccentTextBrush}"/>
                                                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9.5" FontWeight="Bold"
                                                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Grid>
                                                                <TextBlock Text="深色" FontSize="12.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </UniformGrid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="16,0,0,0"/>
                                        <Grid MinHeight="50" Margin="16,6,14,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="自动" FontSize="14"/>
                                                <TextBlock Text="跟随 Windows 的浅色 / 深色设置" Style="{StaticResource Subtle}" FontSize="11.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <nx:IosSwitch x:Name="AutoThemeSwitch" Grid.Column="1" VerticalAlignment="Center"
                                                          IsChecked="{Binding AutoTheme, Mode=TwoWay}"
                                                          OnBrush="{DynamicResource HealthyRingBrush}" OffBrush="{DynamicResource SwitchOffBrush}"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="16,0,0,0"/>
                                        <Grid MinHeight="50" Margin="16,6,14,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="液态玻璃背景" FontSize="14"/>
                                                <TextBlock Text="主窗口与抽屉呈现实时半透折射景深" Style="{StaticResource Subtle}" FontSize="11.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <nx:IosSwitch x:Name="GlassSwitch" Grid.Column="1" VerticalAlignment="Center"
                                                          IsChecked="{Binding GlassBackdrop, Mode=TwoWay}"
                                                          OnBrush="{DynamicResource HealthyRingBrush}" OffBrush="{DynamicResource SwitchOffBrush}"/>
                                        </Grid>

                                        <nx:ExpandBox IsExpanded="{Binding GlassBackdrop}">
                                            <StackPanel>
                                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="16,0,0,0"/>
                                                <StackPanel Margin="16,8,14,10">
                                                    <Grid Margin="0,0,2,3">
                                                        <TextBlock Text="玻璃通透浓度" FontSize="13.5" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding GlassLevelLabel, FallbackValue=48%}" Style="{StaticResource Subtle}"
                                                                   FontSize="12.5" Typography.NumeralAlignment="Tabular"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="温润" Style="{StaticResource Subtle}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <nx:LiquidSlider x:Name="GlassLevelSlider" Grid.Column="1"
                                                                         Value="{Binding GlassLevel, Mode=TwoWay}"
                                                                         TrackBrush="{DynamicResource SliderTrackBrush}"
                                                                         FillBrush="{DynamicResource SliderFillBrush}"
                                                                         AutomationProperties.Name="玻璃通透浓度"/>
                                                        <TextBlock Grid.Column="2" Text="晶透" Style="{StaticResource Subtle}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </nx:ExpandBox>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="16,0,0,0"/>
                                        <Button x:Name="FontRowButton" Style="{StaticResource GroupButton}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Style="{StaticResource SettingSwatch}" Background="#5856D6">
                                                    <TextBlock Text="Aa" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </ContentControl>
                                                <TextBlock Grid.Column="1" Text="界面字体" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FontLabel, FallbackValue=系统默认}" Style="{StaticResource Subtle}"
                                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                           Foreground="{DynamicResource ChevronBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- 刷新 -->
                                <TextBlock Text="刷新" Style="{StaticResource SectionLabel}" Margin="12,18,0,7"/>
                                <Border Style="{StaticResource Group}">
                                    <StackPanel>
                                        <Button x:Name="IntervalRowButton" Style="{StaticResource GroupButton}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Style="{StaticResource SettingSwatch}" Background="#007AFF">
                                                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </ContentControl>
                                                <TextBlock Grid.Column="1" Text="刷新间隔" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding IntervalLabel, FallbackValue=1 分钟}" Style="{StaticResource Subtle}"
                                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="3" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                           Foreground="{DynamicResource ChevronBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="56,0,0,0"/>
                                        <Grid MinHeight="50" Margin="14,6,14,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource SettingSwatch}" Background="#28C84E">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ContentControl>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="自动刷新" FontSize="14"/>
                                                <TextBlock Text="仅主窗口" Style="{StaticResource Subtle}" FontSize="11.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <nx:IosSwitch Grid.Column="2" VerticalAlignment="Center" IsChecked="{Binding AutoRefresh, Mode=TwoWay}"
                                                          OnBrush="{DynamicResource HealthyRingBrush}" OffBrush="{DynamicResource SwitchOffBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 通知与系统 -->
                                <TextBlock Text="通知与系统" Style="{StaticResource SectionLabel}" Margin="12,18,0,7"/>
                                <Border Style="{StaticResource Group}">
                                    <StackPanel>
                                        <Grid MinHeight="46" Margin="14,4,14,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource SettingSwatch}" Background="#64748B">
                                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ContentControl>
                                            <TextBlock Grid.Column="1" Text="开机启动托盘" FontSize="14" VerticalAlignment="Center"/>
                                            <nx:IosSwitch Grid.Column="2" VerticalAlignment="Center" IsChecked="{Binding Autostart, Mode=TwoWay}"
                                                          OnBrush="{DynamicResource HealthyRingBrush}" OffBrush="{DynamicResource SwitchOffBrush}"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="56,0,0,0"/>
                                        <Grid MinHeight="46" Margin="14,4,14,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource SettingSwatch}" Background="#FF3B30">
                                                <TextBlock Text="&#xEBA5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ContentControl>
                                            <TextBlock Grid.Column="1" Text="低电量提醒" FontSize="14" VerticalAlignment="Center"/>
                                            <nx:IosSwitch Grid.Column="2" VerticalAlignment="Center" IsChecked="{Binding LowBatteryAlert, Mode=TwoWay}"
                                                          OnBrush="{DynamicResource HealthyRingBrush}" OffBrush="{DynamicResource SwitchOffBrush}"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="56,0,0,0"/>
                                        <Grid MinHeight="50" Margin="14,6,14,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource SettingSwatch}" Background="#6366F1">
                                                <TextBlock Text="&#xEC4A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ContentControl>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="GPU 动画加速" FontSize="14"/>
                                                <TextBlock Text="不支持时自动兼容" Style="{StaticResource Subtle}" FontSize="11.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <nx:IosSwitch Grid.Column="2" VerticalAlignment="Center" IsChecked="{Binding GpuAnimation, Mode=TwoWay}"
                                                          OnBrush="{DynamicResource HealthyRingBrush}" OffBrush="{DynamicResource SwitchOffBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="低电量提醒会在设备电量低于 10% 时发送 Windows 通知。" Style="{StaticResource Subtle}"
                                           FontSize="11.5" Margin="12,7,12,0" TextWrapping="Wrap"/>

                                <!-- 软件更新 -->
                                <Border Style="{StaticResource Group}" Margin="0,18,0,0">
                                    <Button x:Name="UpdateRowButton" Style="{StaticResource GroupButton}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource SettingSwatch}" Background="#0EA5E9">
                                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ContentControl>
                                            <TextBlock Grid.Column="1" Text="软件更新" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding VersionBadge, FallbackValue=v74.0}"
                                                       Foreground="{Binding VersionBadgeBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{DynamicResource ChevronBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </Border>

                                <!-- 工具 -->
                                <TextBlock Text="工具" Style="{StaticResource SectionLabel}" Margin="12,18,0,7"/>
                                <Border Style="{StaticResource Group}">
                                    <StackPanel>
                                        <Button x:Name="TestAlertButton" Style="{StaticResource GroupButton}" HorizontalContentAlignment="Left"
                                                Content="发送测试提醒" Foreground="{DynamicResource AccentTextBrush}"/>
                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="16,0,0,0"/>
                                        <Button x:Name="RebuildLinksButton" Style="{StaticResource GroupButton}" HorizontalContentAlignment="Left"
                                                Content="重建桌面入口" Foreground="{DynamicResource AccentTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="SettingsFeedback" Text="{Binding ToolFeedback, FallbackValue=''}"
                                           Style="{StaticResource OptionalText}" FontSize="12" Margin="12,8,12,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Page 2: UI Font Selector -->
                        <ScrollViewer x:Name="SettingsFontsPage" Visibility="Collapsed" Background="Transparent"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" nx:Motion.SmoothScroll="True">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform/>
                            </ScrollViewer.RenderTransform>
                            <StackPanel Margin="16,4,16,22">
                                <Border Style="{StaticResource Group}" Padding="16,12,16,14">
                                    <StackPanel>
                                        <TextBlock Text="字体预览" Style="{StaticResource Subtle}" FontSize="11.5"/>
                                        <TextBlock Text="设备" FontSize="25" FontWeight="{DynamicResource UiHeadingWeight}" Margin="0,4,0,2"/>
                                        <TextBlock Text="AULA F87 Pro  ·  已连接  ·  76%" Style="{StaticResource Subtle}" FontSize="13.5"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="系统字体与阿里巴巴普惠体 2.0" Style="{StaticResource SectionLabel}" Margin="12,16,0,7"/>
                                <StackPanel Visibility="{Binding ShowGetFontHint, Converter={StaticResource Visible}}" Margin="12,0,12,10">
                                    <Button x:Name="GetPuHuiTiButton" Content="获取阿里巴巴普惠体 2.0 ↗" Style="{StaticResource TextButton}"
                                            HorizontalAlignment="Left" Padding="0"/>
                                    <TextBlock Text="安装所需字重后重新打开 Nexus 即可选择。" Style="{StaticResource Subtle}" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Style="{StaticResource Group}">
                                    <ItemsControl x:Name="FontChoicesList" ItemsSource="{Binding FontChoices}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Divider}" Margin="16,0,0,0">
                                                    <Button Style="{StaticResource GroupButton}" Tag="{Binding Key}" Margin="-16,0,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" FontFamily="{Binding Family}" FontWeight="{Binding Weight}"
                                                                       FontSize="14.5" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" VerticalAlignment="Center"
                                                                       Visibility="{Binding Selected, Converter={StaticResource Visible}}"/>
                                                        </Grid>
                                                    </Button>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Page 3: Software Updates -->
                        <Border x:Name="SettingsUpdatesPage" Visibility="Collapsed" Background="Transparent" Padding="16,4,16,18">
                            <Border.RenderTransform>
                                <TranslateTransform/>
                            </Border.RenderTransform>
                            <Border Style="{StaticResource Group}" Padding="16,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding CurrentVersionText, FallbackValue=当前版本 v74.0}" Style="{StaticResource Subtle}" FontSize="12" Margin="0,0,0,8"/>
                                    <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource SoftFillBrush}" Padding="12,10" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding UpdateStatus, FallbackValue=点击“检查更新”获取最新正式版本。}"
                                                   FontSize="12.5" TextWrapping="Wrap"/>
                                    </Border>
                                    <Border Grid.Row="2" CornerRadius="10" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="12,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="更新说明" FontSize="13" FontWeight="{DynamicResource UiStrongWeight}" Margin="0,0,0,6"/>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" nx:Motion.SmoothScroll="True">
                                                <TextBlock Text="{Binding UpdateNotes, FallbackValue=新的功能改进和设备适配会在这里显示。}"
                                                           Style="{StaticResource Subtle}" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <!-- Animated Progress Bar -->
                                    <Border x:Name="UpdateProgressTrack" Grid.Row="3" Height="6" CornerRadius="3"
                                            Background="{DynamicResource SoftFillBrush}" Margin="0,12,0,6" ClipToBounds="True">
                                        <Border x:Name="UpdateProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="3"
                                                Background="{DynamicResource SliderFillBrush}"/>
                                    </Border>

                                    <Grid Grid.Row="4" MinHeight="38" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="自动检查更新并提醒" Style="{StaticResource Subtle}" FontSize="13" VerticalAlignment="Center"/>
                                        <nx:IosSwitch x:Name="UpdateAutoSwitch" Grid.Column="1" VerticalAlignment="Center"
                                                      IsChecked="{Binding UpdateAutoCheck, Mode=TwoWay}"
                                                      OnBrush="{DynamicResource HealthyRingBrush}" OffBrush="{DynamicResource SwitchOffBrush}"/>
                                    </Grid>

                                    <Grid Grid.Row="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="OpenReleasesButton" Content="发布记录" Style="{StaticResource SecondaryPillButton}"/>
                                        <Button x:Name="IgnoreUpdateButton" Grid.Column="1" Content="忽略此版" Style="{StaticResource SecondaryPillButton}"
                                                IsEnabled="{Binding CanIgnoreUpdate}" Margin="8,0,0,0"/>
                                        <Button x:Name="UpdatePrimaryButton" Grid.Column="3" Content="{Binding UpdatePrimaryLabel, FallbackValue=检查更新}"
                                                IsEnabled="{Binding UpdatePrimaryEnabled}" Style="{StaticResource PillButton}"
                                                Background="{DynamicResource RefreshButtonFillBrush}"
                                                BorderBrush="{DynamicResource RefreshButtonEdgeBrush}" BorderThickness="1"
                                                Foreground="White" Padding="18,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== NATIVE ADD DEVICE SHEET ==================== -->
        <Grid x:Name="AddLayer" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" ClipToBounds="True">
            <Border x:Name="AddDim" Background="{DynamicResource SheetDimBrush}" Opacity="0"/>
            <Border x:Name="AddSheet" VerticalAlignment="Stretch" Margin="0,44,0,0" CornerRadius="20,20,0,0"
                    Background="{DynamicResource SheetFillBrush}" BorderBrush="{DynamicResource SheetEdgeBrush}" BorderThickness="0,1,0,0"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.Name="添加设备">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="3" Height="64" VerticalAlignment="Top" CornerRadius="20,20,0,0"
                            Background="{DynamicResource SheetTopGlowBrush}" IsHitTestVisible="False"/>

                    <!-- Header -->
                    <Grid x:Name="AddHandle" Height="54" Background="Transparent" Cursor="SizeNS" ToolTip="向下拖动以关闭">
                        <Border Style="{StaticResource SheetGrabber}"/>
                        <Button x:Name="AddRescanButton" Content="{Binding RescanLabel, FallbackValue=重新搜索}"
                                IsEnabled="{Binding CanRescan}" Style="{StaticResource TextButton}" Cursor="Hand"
                                ToolTip="重新扫描外设（F5）" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,8,0,0"/>
                        <TextBlock Text="添加设备" FontSize="15" FontWeight="{DynamicResource UiStrongWeight}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <Button x:Name="AddDoneButton" Content="完成" Style="{StaticResource TextButton}" Cursor="Hand"
                                FontWeight="{DynamicResource UiStrongWeight}" ToolTip="{x:Null}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,8,0"/>
                    </Grid>

                    <!-- Flat Frosted Glass Segmented Control (2.4G / USB vs Bluetooth) -->
                    <Border x:Name="AddSegmentTrack" Grid.Row="1" Height="36" CornerRadius="18" Margin="16,0,16,10"
                            Background="{DynamicResource SegmentTrackBrush}" BorderBrush="{DynamicResource SegmentTrackEdgeBrush}"
                            BorderThickness="1" Padding="3">
                        <Grid x:Name="AddSegmentInner">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AddSegmentThumb" CornerRadius="15"
                                    Background="{DynamicResource SegmentThumbBrush}"
                                    BorderBrush="{DynamicResource SegmentThumbEdgeBrush}" BorderThickness="1"
                                    IsHitTestVisible="False"/>
                            <Button x:Name="AddUsbTab" Cursor="Hand" FontSize="12.5"
                                    FontWeight="{Binding UsbTabWeight}" Foreground="{Binding UsbTabBrush}"
                                    FocusVisualStyle="{StaticResource SegmentFocusVisual}" AutomationProperties.Name="2.4G 与 USB 设备">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Border x:Name="HoverBg" CornerRadius="15" Background="{DynamicResource SegmentTabHoverBrush}" Opacity="0" IsHitTestVisible="False"/>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE88E;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="2.4G / USB" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="AddBtTab" Grid.Column="1" Cursor="Hand" FontSize="12.5"
                                    FontWeight="{Binding BtTabWeight}" Foreground="{Binding BtTabBrush}"
                                    FocusVisualStyle="{StaticResource SegmentFocusVisual}" AutomationProperties.Name="蓝牙设备">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Border x:Name="HoverBg" CornerRadius="15" Background="{DynamicResource SegmentTabHoverBrush}" Opacity="0" IsHitTestVisible="False"/>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="蓝牙设备" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Discovered Devices & Options -->
                    <ScrollViewer x:Name="AddScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False" nx:Motion.SmoothScroll="True">
                        <StackPanel Margin="16,4,16,22">
                            <StackPanel Orientation="Horizontal" Margin="12,4,12,7">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,7,0"
                                         Visibility="{Binding Busy, Converter={StaticResource Visible}}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Busy}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Name="ScanDotPulse">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.65"
                                                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="ScanDotPulse"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusText, FallbackValue=准备搜索…}" Style="{StaticResource SectionLabel}"/>
                            </StackPanel>

                            <!-- Scanning / Empty / Error Placeholder Card -->
                            <Border Style="{StaticResource Group}" Padding="16,18" Visibility="{Binding ShowPlaceholder, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding PlaceholderTitle}" FontSize="14" FontWeight="{DynamicResource UiStrongWeight}"/>
                                    <TextBlock Text="{Binding PlaceholderDetail, FallbackValue=''}" Style="{StaticResource OptionalText}"
                                               FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Discovered Devices Group -->
                            <Border Style="{StaticResource Group}" Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
                                <ItemsControl x:Name="AddDevicesList" ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Divider}" Margin="14,0,0,0">
                                                <StackPanel Margin="-14,0,0,0">
                                                    <!-- Main Tappable Row -->
                                                    <Grid MinHeight="60" Margin="14,0,12,0" Background="Transparent" Cursor="Hand" Tag="{Binding InstanceId}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource ArtworkFillBrush}"
                                                                BorderBrush="{DynamicResource ArtworkEdgeBrush}" BorderThickness="1"
                                                                VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <Grid>
                                                                <Image Source="{Binding Artwork}" Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                                           Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Artwork}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Model}" FontSize="14" FontWeight="{DynamicResource UiStrongWeight}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" FontSize="11.5"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE73E; 已添加" FontFamily="Microsoft YaHei UI, Segoe MDL2 Assets" FontSize="12.5"
                                                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                       Visibility="{Binding ShowAddedLabel, Converter={StaticResource Visible}}"/>
                                                            <Button Tag="{Binding InstanceId}" Name="AddRowActionBtn" Content="{Binding ActionLabel}"
                                                                    Style="{StaticResource PillButton}" Height="28" Padding="13,0" FontSize="12"
                                                                    Background="{DynamicResource RefreshButtonFillBrush}" Foreground="#F4F8FF"
                                                                    BorderBrush="{DynamicResource RefreshButtonEdgeBrush}" BorderThickness="1"
                                                                    Visibility="{Binding ShowActionButton, Converter={StaticResource Visible}}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Smooth Accordion Details & AULA Model/Variant Pickers -->
                                                    <nx:ExpandBox IsExpanded="{Binding Expanded}">
                                                        <StackPanel Margin="64,0,14,12">
                                                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,4"/>
                                                            <Button Name="AulaModelBtn" Tag="{Binding InstanceId}" Style="{StaticResource GroupButton}" MinHeight="40" Margin="-14,0"
                                                                    Visibility="{Binding AulaEligible, Converter={StaticResource Visible}}">
                                                                <Grid>
                                                                    <TextBlock Text="狼蛛型号" FontSize="13" VerticalAlignment="Center"/>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding SelectedModelLabel}" Foreground="{DynamicResource AccentTextBrush}"
                                                                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9.5"
                                                                                   Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                            <Border Height="1" Background="{DynamicResource DividerBrush}"
                                                                    Visibility="{Binding HasVariants, Converter={StaticResource Visible}}"/>
                                                            <Button Name="AulaVariantBtn" Tag="{Binding InstanceId}" Style="{StaticResource GroupButton}" MinHeight="40" Margin="-14,0"
                                                                    Visibility="{Binding HasVariants, Converter={StaticResource Visible}}">
                                                                <Grid>
                                                                    <TextBlock Text="配色" FontSize="13" VerticalAlignment="Center"/>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                        <Ellipse Width="11" Height="11" Fill="{Binding PrimarySwatch}" Stroke="{DynamicResource DividerBrush}"
                                                                                 StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                        <Ellipse Width="11" Height="11" Fill="{Binding SecondarySwatch}" Stroke="{DynamicResource DividerBrush}"
                                                                                 StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <TextBlock Text="{Binding SelectedVariantLabel}" Foreground="{DynamicResource AccentTextBrush}"
                                                                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9.5"
                                                                                   Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                            <TextBlock Text="{Binding DetailsText}" Style="{StaticResource Subtle}" FontSize="11.5"
                                                                       TextWrapping="Wrap" Margin="0,6,0,4"/>
                                                            <Button Name="CopyInfoBtn" Tag="{Binding InstanceId}" Content="复制设备信息"
                                                                    Style="{StaticResource TextButton}" FontSize="12.5" Height="26" Padding="0"
                                                                    HorizontalAlignment="Left"/>
                                                        </StackPanel>
                                                    </nx:ExpandBox>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <TextBlock x:Name="AddFeedbackText" Text="{Binding FeedbackText, FallbackValue=''}"
                                       Foreground="{Binding FeedbackBrush}" FontSize="12" TextWrapping="Wrap" Margin="12,8,12,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Style="{StaticResource Group}" Margin="0,16,0,0"
                                    Visibility="{Binding IsUsbMode, Converter={StaticResource Visible}}">
                                <Grid MinHeight="46" Margin="16,4,14,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="显示待确认的 USB 设备" FontSize="14" VerticalAlignment="Center"/>
                                    <nx:IosSwitch Grid.Column="1" VerticalAlignment="Center"
                                                  IsChecked="{Binding ShowOtherUsb, Mode=TwoWay}"
                                                  OnBrush="{DynamicResource HealthyRingBrush}" OffBrush="{DynamicResource SwitchOffBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding HintText, FallbackValue=''}" Style="{StaticResource OptionalText}"
                                       FontSize="11.5" Margin="12,8,12,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
